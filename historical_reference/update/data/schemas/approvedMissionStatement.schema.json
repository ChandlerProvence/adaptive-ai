{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APPROVED_MISSION_STATEMENT",
  "description": "MDMP artifact for Approved Mission Statement (COA Comparison).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "context",
    "display_text",
    "approved_content",
    "citations"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "APPROVED_MISSION_STATEMENT"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "mission_type",
        "organization_id",
        "team_id",
        "aoi",
        "time_window",
        "task_id",
        "purpose_id"
      ],
      "properties": {
        "mission_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "mission_type": {
          "type": "string"
        },
        "organization_id": {
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "aoi": {
          "type": "string"
        },
        "aor": {
          "type": "string"
        },
        "time_window": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "purpose_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "display_text": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable narrative for the UI (markdown allowed). Conversational briefing prose; do not embed JSON or code fences."
    },
    "approved_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence_refs"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "sketch_notes": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/citation_id"
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/definitions/citation"
      }
    }
  },
  "definitions": {
    "citation_id": {
      "type": "string",
      "pattern": "^CIT-[0-9]{4}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source_system",
        "document_id",
        "document_version",
        "retrieval_time",
        "range",
        "snippet"
      ],
      "properties": {
        "citation_id": {
          "$ref": "#/definitions/citation_id"
        },
        "source_system": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "document_version": {
          "type": "string"
        },
        "retrieval_time": {
          "type": "string",
          "format": "date-time"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "start",
            "end"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "char",
                "page_line",
                "timecode"
              ]
            },
            "start": {
              "type": [
                "integer",
                "string"
              ]
            },
            "end": {
              "type": [
                "integer",
                "string"
              ]
            },
            "page": {
              "type": "integer"
            },
            "line_start": {
              "type": "integer"
            },
            "line_end": {
              "type": "integer"
            }
          }
        },
        "snippet": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1200
        },
        "canonical_uri": {
          "type": "string"
        }
      }
    }
  }
}
