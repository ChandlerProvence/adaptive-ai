{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "COMMANDERS_INTENT",
  "description": "Commander's intent extraction with evidence citations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "context",
    "intent",
    "citations"
  ],
  "properties": {
    "artifact_type": {
      "type": "string",
      "const": "COMMANDERS_INTENT"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "mission_type",
        "organization_id",
        "team_id",
        "aoi",
        "time_window",
        "task_id",
        "purpose_id"
      ],
      "properties": {
        "mission_id": { "type": ["string", "integer"] },
        "mission_type": { "type": "string" },
        "organization_id": { "type": "string" },
        "team_id": { "type": "string" },
        "aoi": { "type": "string" },
        "aor": { "type": "string" },
        "time_window": { "type": "string" },
        "task_id": { "type": "string" },
        "purpose_id": { "type": "string" },
        "run_id": { "type": "string" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end_state", "key_tasks", "success_conditions"],
      "properties": {
        "end_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "evidence_refs"],
          "properties": {
            "description": { "type": "string", "minLength": 10 },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/citation_id" }
            }
          }
        },
        "key_tasks": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "evidence_refs"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string", "minLength": 10 },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/citation_id" }
              }
            }
          }
        },
        "success_conditions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "evidence_refs"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string", "minLength": 10 },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/citation_id" }
              }
            }
          }
        },
        "intent_statements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "type", "evidence_refs"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string", "minLength": 10 },
              "type": { "type": "string", "enum": ["explicit", "inferred"] },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/definitions/citation_id" }
              }
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/definitions/citation" }
    }
  },
  "definitions": {
    "citation_id": {
      "type": "string",
      "pattern": "^CIT-[0-9]{4}$"
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source_system",
        "document_id",
        "document_version",
        "retrieval_time",
        "range",
        "snippet"
      ],
      "properties": {
        "citation_id": { "$ref": "#/definitions/citation_id" },
        "source_system": { "type": "string" },
        "document_id": { "type": "string" },
        "document_version": { "type": "string" },
        "retrieval_time": { "type": "string", "format": "date-time" },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "start", "end"],
          "properties": {
            "type": { "type": "string", "enum": ["char", "page_line", "timecode"] },
            "start": { "type": ["integer", "string"] },
            "end": { "type": ["integer", "string"] },
            "page": { "type": "integer" },
            "line_start": { "type": "integer" },
            "line_end": { "type": "integer" }
          }
        },
        "snippet": { "type": "string", "minLength": 5, "maxLength": 1200 },
        "canonical_uri": { "type": "string" }
      }
    }
  }
}
